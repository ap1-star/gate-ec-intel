# Configuration names only. This file is not loaded by the static application.
# Keep real secrets in the destination server secret manager, outside dist and Git.
GATE_INTEGRATION_MODE=static
GATE_PUBLIC_ORIGIN=
GATE_API_ORIGIN=
# Future identity adapter; never assume the original Manus OAuth is available.
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_SESSION_STRATEGY=provider
AUTH_OWNER_SUBJECT=
# Required only for a deliberately selected HMAC session strategy.
SESSION_SECRET=
# Future supported SQL adapter; source migrations are MySQL, not D1/SQLite.
DATABASE_URL=
# Future scheduler adapter; no callbacks or jobs are activated in Part 1.
SCHEDULER_SIGNING_SECRET=
