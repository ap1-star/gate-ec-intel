td><span class=\"sub\">${esc(r.admission_route)}</span><br>${esc(r.cutoff_type)}</td>${K.map(k => `<td class=\"num ${k === col ? \"me\" : \"\"}\" data-k=\"${k.replace(\"_NCL\",\"\")}\">${esc(val(r, k) || \"—\")}</td>`).join(\"\")}</tr>`).join(\"\")}</tbody></table></div></div>\n       <details><summary>Eligibility, notes and sources</summary>${qd ? `<p><b>Eligible degrees:</b> ${esc(qd)}</p>` : \"\"}${notes.map(n => `<p>${esc(n)}</p>`).join(\"\")}"}]}