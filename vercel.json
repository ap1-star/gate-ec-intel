{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {"source": "/recruitment/verify-email", "destination": "/api/confirmation?kind=verify-email"},
    {"source": "/recruitment/unsubscribe", "destination": "/api/confirmation?kind=unsubscribe"}
  ]
}
