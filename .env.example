# RENDER / RAILWAY / NODE BACKEND
# Render and Railway infer their generated domain. Set this for a custom / Netlify / Vercel frontend domain.
PUBLIC_ORIGIN=
# Optional: blank generates a key beside SQLite. Keep /data on a persistent volume.
SESSION_SECRET=
SQLITE_PATH=/data/workspace.sqlite
OWNER_USER_ID=
RUN_SCHEDULER=true
SCHEDULER_INTERVAL_MS=60000

# NETLIFY / VERCEL FRONTEND (set in the hosting dashboard, never client JS)
BACKEND_ORIGIN=

# OPTIONAL NOTIFICATION PROVIDERS; all external channels stay off without setup and consent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_SIGNING_SECRET=
RESEND_API_KEY=
RECRUITMENT_EMAIL_FROM=
EMAIL_SENDER_VERIFIED=false
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
WHATSAPP_TEMPLATE_APPROVED=false
TWILIO_SMS_MESSAGING_SERVICE_SID=
TWILIO_SMS_CONTENT_SID=
SMS_DLT_APPROVED=false
